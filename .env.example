# Palab — variables d'environnement.
#
# Copiez ce fichier en .env.local pour le développement, et reportez les mêmes
# valeurs dans Vercel (Settings > Environment Variables) pour la production.
# .env.local est ignoré par git : aucune clé ne doit être commitée.

# --- Publiques : envoyées au navigateur, protégées par le RLS ---------------
NEXT_PUBLIC_SUPABASE_URL=https://lwkhkhyqhkubtthmvfkx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ancienne nomenclature, acceptée en repli si la clé publiable n'est pas posée.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secrète : serveur uniquement, contourne le RLS ------------------------
# À prendre dans Supabase > Settings > API. Ne jamais la placer dans une
# variable NEXT_PUBLIC_*, ni la commiter, ni la coller dans une conversation.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paiement (Paddle) -----------------------------------------------------
# Bac à sable tant que PADDLE_ENV ne vaut pas « production ». Une clé de bac à
# sable contient « _sdbx » ; un jeton navigateur de bac à sable commence par
# « test_ », celui de production par « live_ ».

# Serveur uniquement. À prendre dans Paddle > Developer tools > Authentication.
PADDLE_API_KEY=

# Secret de signature de la destination de notifications, montré une seule fois
# à sa création. Sans lui, aucune notification n'est acceptée.
PADDLE_WEBHOOK_SECRET=

# Envoyé au navigateur : il n'ouvre que le tunnel de paiement.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Bascule serveur et navigateur. Laisser vide pour le bac à sable ; mettre
# « production » des deux côtés le jour du passage en direct.
PADDLE_ENV=
NEXT_PUBLIC_PADDLE_ENV=

# --- Domaine public ----------------------------------------------------
# Utilisée dans les pages légales et les métadonnées. Vercel la pose seule sur
# les prévisualisations (VERCEL_URL) ; posez celle-ci en production pour
# qu'elle affiche le vrai domaine plutôt que l'adresse .vercel.app.
NEXT_PUBLIC_SITE_URL=https://palab.love
